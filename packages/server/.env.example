# idle-dark-forever 服务端环境变量样例（复制为 .env）
# 单端口三合一：REST /api + WS /ws 共用 PORT
PORT=3000

# PostgreSQL 连接串（scripts/init-db.mjs 与 DatabaseService 共用）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/idle_dark

# HS256 JWT：密钥与有效期（REST 登录签发，WS 握手校验）
JWT_SECRET=dev-secret-change-me
# 秒数（604800 = 7 天），也接受 7d / 12h / 30m 这类时长串
JWT_EXPIRES_IN=604800

# 框架默认在 NODE_ENV=production 下拒绝启动；自管 Node 生产部署时显式置 true
IONET_ALLOW_PRODUCTION=false
