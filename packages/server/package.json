{
  "name": "idle-dark-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "idle-dark-forever 权威服务端：NestJS + ionet-ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "db:init": "node scripts/init-db.mjs",
    "dev": "node scripts/dev.mjs",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:validate": "prisma validate",
    "smoke:game": "node scripts/game-flow-smoke.mjs",
    "smoke:routes": "node scripts/route-probe.mjs",
    "smoke:ws": "node scripts/ws-protocol-smoke.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@idle-dark/game-core": "workspace:*",
    "@idle-dark/protocol": "workspace:*",
    "@nbb-ionet/core-framework": "workspace:*",
    "@nbb-ionet/extension-nestjs": "workspace:*",
    "@nbb-ionet/external-server": "workspace:*",
    "@nbb-ionet/redis": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "prisma": "^5.10.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
