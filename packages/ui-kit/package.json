{
  "name": "@idle-dark/ui-kit",
  "version": "0.1.0",
  "private": true,
  "description": "idle-dark-forever 通用 UI 组件层：只依赖 antd + React，零业务、零 store、零传输依赖（编译期强制）。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "antd": "^6.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "antd": "^6.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
