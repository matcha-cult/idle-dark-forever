{
  "name": "idle-dark-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "idle-dark-forever Web 前端（React + Vite + Antd + MobX），经 @idle-dark/ionet-transport 接入后端 WS",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@idle-dark/ionet-transport": "workspace:*",
    "@idle-dark/protocol": "workspace:*",
    "@idle-dark/ui-kit": "workspace:*",
    "@nbb-ionet/client-protocol": "workspace:*",
    "antd": "^6.6.3",
    "mobx": "^6.12.0",
    "mobx-react-lite": "^4.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
