{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@idle-dark/ionet-transport": ["../ionet-transport/src/index.ts"],
      "@idle-dark/ionet-transport/testing": ["../ionet-transport/src/testing/index.ts"],
      "@idle-dark/ui-kit": ["../ui-kit/src/index.ts"],
      "@idle-dark/protocol": ["../protocol/src/index.ts"],
      "@idle-dark/game-core": ["../game-core/src/index.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
